{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "OverwolfApp",
    "author": "coltsfan0791",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.235.0.0",
    "description": "Overwolf overlay app scaffold with a desktop window and an in-game overlay window.",
    "icon": "icons/icon.png",
    "icon_gray": "icons/icon_gray.png"
  },
  "permissions": [
    "Extensions",
    "Hotkeys",
    "GameInfo"
  ],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "src/background/background.html",
        "is_background_page": true
      },
      "desktop": {
        "file": "src/windows/desktop/desktop.html",
        "desktop_only": true,
        "native_window": true,
        "resizable": true,
        "show_in_taskbar": true,
        "size": {
          "width": 900,
          "height": 600
        },
        "min_size": {
          "width": 600,
          "height": 400
        }
      },
      "overlay": {
        "file": "src/windows/overlay/overlay.html",
        "in_game_only": true,
        "transparent": true,
        "clickthrough": false,
        "resizable": false,
        "size": {
          "width": 400,
          "height": 300
        }
      }
    }
  }
}
